{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Majra",
  "version": "2.0.4",
  "identifier": "app.majra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Majra",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-background-networking --disable-sync --no-first-run"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["majra"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRDA1QjM3QTYzMEIyQTYKUldTbXNqQ21OMXZRbXp5dUJlQlo2cE8rams0SjV5VElwQ2E1YW5sWDdhQWYwbXl5Z0dHRUlMRSsK",
      "endpoints": [
        "https://github.com/bouadjadjatamer2-hub/Majra/releases/latest/download/latest.json"
      ]
    }
  }
}
